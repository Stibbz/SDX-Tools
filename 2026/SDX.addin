    <Text>Detail Lines Length</Text>
    <Description>Measure total length of detail lines by style in the active view.</Description>
  </AddIn>

  <AddIn Type="Command">
    <Name>SDX: Toggle Section Box</Name>
    <Assembly>SDX.dll</Assembly>
