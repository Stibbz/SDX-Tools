    <ClientId>912b70f5-8d43-4ea1-a63a-77d7cc846189</ClientId>
    <VendorId>SDraak</VendorId>
    <Text>AutoSync Settings</Text>
    <Description>Configure auto-save and sync-to-central intervals.</Description>
  </AddIn>

  <AddIn Type="Command">
    <Name>SDX: Hide CAD Layer</Name>
    <Assembly>SDX.dll</Assembly>
    <FullClassName>SDX.HideCadLayer.HideCadLayerCommand</FullClassName>
    <ClientId>7efd7fb5-71d6-45d3-b3c0-91a9519842ab</ClientId>
    <VendorId>SDraak</VendorId>
    <Text>Hide CAD Layer</Text>
    <Description>Click a line on an imported CAD drawing to hide that layer in the active view.</Description>
  </AddIn>

  <AddIn Type="Command">
    <Name>SDX: Unhide All</Name>
    <Assembly>SDX.dll</Assembly>
    <FullClassName>SDX.UnhideAll.UnhideAll</FullClassName>
    <ClientId>e0562b38-b5c0-4f98-a05f-1d0c7c549274</ClientId>
