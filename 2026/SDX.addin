  </AddIn>

  <AddIn Type="Command">
    <Name>SDX: Free Dim (Aligned)</Name>
    <Assembly>SDX.dll</Assembly>
    <FullClassName>SDX.FreeDims.FreeDimsAlignedCommand</FullClassName>
    <ClientId>a3f1c820-7e94-4b5d-9c2a-1d8f6e3b0a75</ClientId>
    <VendorId>SDraak</VendorId>
    <Text>Free Dim (Aligned)</Text>
    <Description>Place a free aligned dimension between any two points — no geometry required.</Description>
