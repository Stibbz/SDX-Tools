<?xml version="1.0" encoding="utf-8"?>
<!--
  Revit 2025 addin manifest for SDX Tools.

  Deployment: copy this entire folder (SDX.addin + SDX.dll) to
    %AppData%\Autodesk\Revit\Addins\2025\

  Development: load bin\Debug\net8.0-windows\SDX.dll via the Addin
    Manager — that file is never locked by the ribbon Revit instance.
-->
<RevitAddIns>

  <!-- ── Application ─ builds the ribbon and starts the AutoSync timer ── -->
  <AddIn Type="Application">
    <Name>SDX Tools</Name>
    <Assembly>SDX.dll</Assembly>
    <FullClassName>SDX.Ribbon.SDXApp</FullClassName>
    <ClientId>46da1c6a-26e8-4e60-b211-c895b4992d36</ClientId>
    <VendorId>SDraak</VendorId>
    <VendorDescription>SDX Tools</VendorDescription>
  </AddIn>

  <!--
    Commands below are intentionally commented out to prevent Revit from showing a
    separate security/load prompt for each tool on first install. With all commands
    registered individually, Revit treats each <AddIn Type="Command"> as a distinct
    add-in and prompts once per entry - resulting in 20+ prompts for a single suite.

    The Application entry above is sufficient for the ribbon and all tool functionality.
    The trade-off is that individual commands are not listed in the keyboard shortcut
    editor (Revit only shows commands from registered <AddIn Type="Command"> entries).

    To re-enable individual keyboard shortcut registration in future, uncomment this
    entire block and re-deploy. Each command will then appear in the KBS editor under
    its <Name> (e.g. "SDX: Hide CAD Layer"), at the cost of one prompt per command
    on first install on a new machine.
  -->
  <!--
  <AddIn Type="Command">
    <Name>SDX: Preferences</Name>
    <Assembly>SDX.dll</Assembly>
    <FullClassName>SDX.Preferences.PreferencesCommand</FullClassName>
    <ClientId>4356fdb7-129b-4867-bb3e-3b79faa65da0</ClientId>
    <VendorId>SDraak</VendorId>
    <Text>Preferences</Text>
    <Description>Configure Fun Mode, AutoSync, and addin ribbon tab visibility in one place.</Description>
  </AddIn>

  <AddIn Type="Command">
    <Name>SDX: Manage Addins</Name>
    <Assembly>SDX.dll</Assembly>
